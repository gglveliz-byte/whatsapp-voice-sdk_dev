# =========================================================================
# 📞 WHATSAPP VOICE SDK — ENVIRONMENT VARIABLES CONFIGURATION
# =========================================================================
# Copy this file as '.env' in the same folder and fill in your keys.

# Local port for the telephony backend server
PORT=3006
NODE_ENV=development

# =========================================================================
# 🗄️ PERSISTENT DATABASE (POSTGRESQL)
# =========================================================================
# On RENDER, the DATABASE_URL variable is auto-generated and connects hot.
# Locally you can use a direct connection string or configure the fields.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/whatsapp_voice_sdk

# Individual connection options (local fallback if DATABASE_URL is not used)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=whatsapp_voice_sdk

# =========================================================================
# 🧠 ARTIFICIAL INTELLIGENCE (GOOGLE AI STUDIO)
# =========================================================================
# Get your free key at: https://aistudio.google.com/
# Note: You can also configure it dynamically from the Web Dashboard.
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_LIVE_VOICE=Aoede
GEMINI_LIVE_INPUT_CHUNK_BYTES=4096
GEMINI_LIVE_VAD_PREFIX_PADDING_MS=250
GEMINI_LIVE_VAD_SILENCE_DURATION_MS=1000
GEMINI_LIVE_VAD_START_SENSITIVITY=START_SENSITIVITY_LOW
GEMINI_LIVE_VAD_END_SENSITIVITY=END_SENSITIVITY_LOW
GEMINI_LIVE_INPUT_TRANSCRIPTION=true
GEMINI_LIVE_OUTPUT_TRANSCRIPTION=true

# =========================================================================
# 📱 METADATA FROM META DEVELOPER PORTAL (WHATSAPP BUSINESS)
# =========================================================================
# Get these values from your Meta App dashboard: https://developers.facebook.com/
# Note: You can also configure them dynamically from the Web Dashboard.
META_ACCESS_TOKEN=
META_VERIFY_TOKEN=whatsapp_voice_sdk_verify_token

# =========================================================================
# 🎙️ WEBRTC AUDIO CONNECTION
# =========================================================================
# STUN/TURN servers for P2P audio negotiation (optional, defaults to Google)
WHATSAPP_CALL_ICE_SERVERS=stun:stun.l.google.com:19302
VOICE_WEBRTC_CONNECT_TIMEOUT_MS=5000
VOICE_OUTPUT_GAIN=1.55
VOICE_MAX_RTP_QUEUE_FRAMES=1200
VOICE_RTP_PACING_LOOKAHEAD_MS=8
VOICE_BARGE_IN_RMS=0.26
VOICE_BARGE_IN_MIN_FRAMES=10
VOICE_BARGE_IN_COOLDOWN_MS=1200
VOICE_BARGE_IN_BACKLOG_MS=250
VOICE_IGNORE_AUDIO_AFTER_INTERRUPT_MS=900
VOICE_GREETING_DELAY_MS=1000
VOICE_TRANSCRIPT_LOGS=false
VOICE_LOCAL_INTERRUPT_SIGNAL=false
