# =========================================================================
# 📞 WHATSAPP VOICE SDK — CONFIGURACIÓN DE VARIABLES DE ENTORNO
# =========================================================================
# Copia este archivo como '.env' en esta misma carpeta y completa tus llaves.

# Puerto local del servidor backend de telefonía
PORT=3006
NODE_ENV=development

# =========================================================================
# 🗄️ BASE DE DATOS PERSISTENTE (POSTGRESQL)
# =========================================================================
# En RENDER, la variable DATABASE_URL se autogenera y se conecta en caliente.
# Localmente puedes usar una cadena de conexión directa o configurar los campos.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/whatsapp_voice_sdk

# Opciones individuales de conexión (fallback local si DATABASE_URL no se usa)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=whatsapp_voice_sdk

# =========================================================================
# 🧠 INTELIGENCIA ARTIFICIAL (GOOGLE AI STUDIO)
# =========================================================================
# Consigue tu llave gratuita en: https://aistudio.google.com/
# Nota: También puedes configurarla dinámicamente desde el Dashboard Web.
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_LIVE_VOICE=Aoede
GEMINI_LIVE_INPUT_CHUNK_BYTES=4096
GEMINI_LIVE_VAD_PREFIX_PADDING_MS=250
GEMINI_LIVE_VAD_SILENCE_DURATION_MS=1000
GEMINI_LIVE_VAD_START_SENSITIVITY=START_SENSITIVITY_LOW
GEMINI_LIVE_VAD_END_SENSITIVITY=END_SENSITIVITY_LOW
GEMINI_LIVE_INPUT_TRANSCRIPTION=true
GEMINI_LIVE_OUTPUT_TRANSCRIPTION=true

# =========================================================================
# 📱 METADATA DE META DEVELOPER PORTAL (WHATSAPP BUSINESS)
# =========================================================================
# Consigue estos valores en tu panel de App en Meta: https://developers.facebook.com/
# Nota: También puedes configurarlos dinámicamente desde el Dashboard Web.
META_ACCESS_TOKEN=
META_VERIFY_TOKEN=whatsapp_voice_sdk_verify_token

# =========================================================================
# 🎙️ CONEXIÓN DE AUDIO WEBRTC
# =========================================================================
# Servidores STUN/TURN para la negociación P2P de audio (opcional, por defecto Google)
WHATSAPP_CALL_ICE_SERVERS=stun:stun.l.google.com:19302
VOICE_WEBRTC_CONNECT_TIMEOUT_MS=5000
VOICE_OUTPUT_GAIN=1.55
VOICE_MAX_RTP_QUEUE_FRAMES=1200
VOICE_RTP_PACING_LOOKAHEAD_MS=8
VOICE_BARGE_IN_RMS=0.26
VOICE_BARGE_IN_MIN_FRAMES=10
VOICE_BARGE_IN_COOLDOWN_MS=1200
VOICE_BARGE_IN_BACKLOG_MS=250
VOICE_IGNORE_AUDIO_AFTER_INTERRUPT_MS=900
VOICE_GREETING_DELAY_MS=1000
VOICE_TRANSCRIPT_LOGS=false
VOICE_LOCAL_INTERRUPT_SIGNAL=false
